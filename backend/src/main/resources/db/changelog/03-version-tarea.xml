<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Version / release -->
    <changeSet id="005-version" author="breogan">
        <createTable tableName="version">
            <column name="id"           type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="proyecto_id"  type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nombre"       type="VARCHAR(120)"/>
            <column name="descripcion"  type="CLOB"/>
            <column name="fecha_inicio" type="DATE"/>
            <column name="fecha_entrega" type="DATE"/>
            <column name="estado"        type="VARCHAR(20)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_version_proyecto"
            baseTableName="version" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id"/>
    </changeSet>

    <!-- Tarea -->
    <changeSet id="006-tarea" author="breogan">
        <createTable tableName="tarea">
            <column name="id"                 type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="proyecto_id"        type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="titulo"             type="VARCHAR(200)"/>
            <column name="descripcion"        type="CLOB"/>
            <column name="puntos_historia"    type="INT"/>
            <column name="esfuerzo_estimado"  type="INT"/>
            <column name="fecha_inicio_plan"  type="DATE"/>
            <column name="fecha_fin_plan"     type="DATE"/>
            <column name="fecha_fin_real"     type="DATE"/>
            <column name="estado"             type="VARCHAR(20)"/>
            <column name="version_id"         type="BIGINT"/>
            <column name="responsable_principal_id" type="BIGINT"/>
        </createTable>

        <!-- FKs -->
        <addForeignKeyConstraint constraintName="fk_tarea_proyecto"
            baseTableName="tarea" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_tarea_version"
            baseTableName="tarea" baseColumnNames="version_id"
            referencedTableName="version" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_tarea_responsable"
            baseTableName="tarea" baseColumnNames="responsable_principal_id"
            referencedTableName="usuario" referencedColumnNames="id"/>
    </changeSet>

    <!-- Asignación tarea-usuario -->
    <changeSet id="007-asignacion_tarea" author="breogan">
        <createTable tableName="asignacion_tarea">
            <column name="tarea_id"   type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="fecha_asignacion" type="TIMESTAMP"/>
            <column name="rol_en_tarea"    type="VARCHAR(60)"/>
        </createTable>

        <addPrimaryKey constraintName="pk_asignacion_tarea"
                    tableName="asignacion_tarea"
                    columnNames="tarea_id,usuario_id"/>
    </changeSet>
</databaseChangeLog>
