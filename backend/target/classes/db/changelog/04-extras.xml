<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.23.xsd">

    <!-- Feedback IA -->
    <changeSet id="008-feedback_ia" author="breogan">
        <createTable tableName="feedback_ia">
            <column name="id"          type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="proyecto_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tarea_id"    type="BIGINT"/>
            <column name="usuario_id"  type="BIGINT"/>
            <column name="prompt"      type="CLOB"/>
            <column name="respuesta"   type="CLOB"/>
            <column name="fecha"       type="TIMESTAMP"/>
            <column name="utilidad"    type="INT"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_fb_proyecto"
            baseTableName="feedback_ia" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_fb_tarea"
            baseTableName="feedback_ia" baseColumnNames="tarea_id"
            referencedTableName="tarea" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_fb_usuario"
            baseTableName="feedback_ia" baseColumnNames="usuario_id"
            referencedTableName="usuario" referencedColumnNames="id"/>
    </changeSet>

    <!-- Notificación -->
    <changeSet id="009-notificacion" author="breogan">
        <createTable tableName="notificacion">
            <column name="id"             type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="usuario_id"     type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="tipo"           type="VARCHAR(60)"/>
            <column name="mensaje"        type="CLOB"/>
            <column name="proyecto_id"    type="BIGINT"/>
            <column name="tarea_id"       type="BIGINT"/>
            <column name="emitido_por"    type="BIGINT"/>
            <column name="fecha_creacion" type="TIMESTAMP"/>
            <column name="leido"          type="BOOLEAN" defaultValueBoolean="false"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="notificacion" baseColumnNames="usuario_id"
            referencedTableName="usuario" referencedColumnNames="id" constraintName="fk_notif_dest"/>

        <addForeignKeyConstraint baseTableName="notificacion" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id" constraintName="fk_notif_proj"/>

        <addForeignKeyConstraint baseTableName="notificacion" baseColumnNames="tarea_id"
            referencedTableName="tarea" referencedColumnNames="id" constraintName="fk_notif_task"/>

        <addForeignKeyConstraint baseTableName="notificacion" baseColumnNames="emitido_por"
            referencedTableName="usuario" referencedColumnNames="id" constraintName="fk_notif_from"/>
    </changeSet>

    <!-- Métricas -->
    <changeSet id="010-metrica_proyecto" author="breogan">
        <createTable tableName="metrica_proyecto">
            <column name="id"             type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="proyecto_id"    type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="nombre_metrica" type="VARCHAR(120)"/>
            <column name="valor"          type="DOUBLE"/>
            <column name="fecha_medicion" type="DATE"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_metric_proj"
            baseTableName="metrica_proyecto" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="011-metrica_chart" author="breogan">
        <createTable tableName="metrica_chart">
            <column name="id"               type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="proyecto_id"      type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="version_id"       type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="pendiente_pts"    type="INT"/>
            <column name="completado_pts"   type="INT"/>
            <column name="alcance_pts"      type="INT"/>
            <column name="fecha_medicion"   type="DATE"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_chart_proj"
            baseTableName="metrica_chart" baseColumnNames="proyecto_id"
            referencedTableName="proyecto" referencedColumnNames="id"/>

        <addForeignKeyConstraint constraintName="fk_chart_version"
            baseTableName="metrica_chart" baseColumnNames="version_id"
            referencedTableName="version" referencedColumnNames="id"/>
    </changeSet>

    <!-- Auditoría -->
    <changeSet id="012-historial_cambios" author="breogan">
        <createTable tableName="historial_cambios">
            <column name="id"          type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="entidad"     type="VARCHAR(120)"/>
            <column name="entidad_id"  type="BIGINT"/>
            <column name="usuario_id"  type="BIGINT"/>
            <column name="accion"      type="VARCHAR(60)"/>
            <column name="detalles"    type="CLOB"/>
            <column name="fecha"       type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_hist_usuario"
            baseTableName="historial_cambios" baseColumnNames="usuario_id"
            referencedTableName="usuario" referencedColumnNames="id"/>
    </changeSet>
</databaseChangeLog>
