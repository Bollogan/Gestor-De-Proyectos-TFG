{
    "compilerOptions": {
        "target": "ESNext",
        "useDefineForClassFields": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "types": ["vite/client"],
        "esModuleInterop": true,            
        "allowSyntheticDefaultImports": true
    },
    "include": ["src", "env.d.ts"]
}